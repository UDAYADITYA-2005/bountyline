# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info

# Local dev uses PGlite (real Postgres 17 in WebAssembly), persisted in .data/dev: no install.
# Production uses Render Postgres (postgres://...). Tests create their own PGlite databases.
DATABASE_URL=pglite://.data/dev

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# PayPal sandbox only. Any other value fails at boot.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUEST_LIMIT=450

# Checks: inline locally, render in production
CHECK_RUNNER=inline
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=bountyline-checks

# Judge mode and demo accounts
JUDGE_MODE=true
DEMO_MANAGER_EMAIL=manager@bountyline.demo
DEMO_MANAGER_PASSWORD=
DEMO_CLAIMANT_PAYPAL_EMAIL=

# Web build. Leave empty until Nov 1 (AG Studio runs locally with a watermark).
VITE_AG_STUDIO_LICENSE_KEY=

# Stretch: desk assistant on the AG Studio Agent Framework (off by default)
VITE_DESK_ASSISTANT=false
