{
  "name": "bountyline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bountyline/api --filter @bountyline/web dev",
    "build": "pnpm --filter @bountyline/web build && pnpm --filter @bountyline/api build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:fast": "pnpm typecheck && pnpm test",
    "env:check": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/env-check.ts",
    "db:generate": "pnpm --filter @bountyline/db generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/api/src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx apps/api/src/seed-cli.ts",
    "eval:checks": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/eval-checks.ts",
    "paypal:smoke": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/paypal-smoke.ts",
    "judge:warm": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/judge-warm.ts",
    "gate1": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/gate1.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.33.0",
    "@eslint/js": "^9.33.0",
    "typescript-eslint": "^8.40.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.17.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  }
}
